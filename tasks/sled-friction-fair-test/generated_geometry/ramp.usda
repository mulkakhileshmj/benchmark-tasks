#usda 1.0
(
    defaultPrim = "part"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "part"
{
    def Mesh "p0" (
        prepend apiSchemas = ["PhysicsMeshCollisionAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        uniform bool doubleSided = 1
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 4, 6, 2, 1, 3, 7, 5, 0, 1, 5, 4, 2, 6, 7, 3, 0, 2, 3, 1, 4, 5, 7, 6]
        rel material:binding:physics = </part/material_0> (
            bindMaterialAs = "weakerThanDescendants"
        )
        uniform token physics:approximation = "convexHull"
        bool physics:collisionEnabled = 1
        float physxCollision:contactOffset = 0.00005
        float physxCollision:restOffset = 0
        point3f[] points = [(-0.09, -0.11, 0.10192305), (-0.09, -0.11, 0.11192305), (-0.09, 0.11, 0.10192305), (-0.09, 0.11, 0.11192305), (0.09, -0.11, -0.002), (0.09, -0.11, 0.008), (0.09, 0.11, -0.002), (0.09, 0.11, 0.008)]
        color3f[] primvars:displayColor = [(0.6, 0.48, 0.3)]
        uniform token subdivisionScheme = "none"
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Material "material_0" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.15
        float physics:restitution = 0
        float physics:staticFriction = 0.15
    }
}

