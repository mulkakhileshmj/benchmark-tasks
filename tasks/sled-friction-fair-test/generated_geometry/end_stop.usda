#usda 1.0
(
    defaultPrim = "part"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "part"
{
    def Cube "p0" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </part/material_0> (
            bindMaterialAs = "weakerThanDescendants"
        )
        bool physics:collisionEnabled = 1
        float physxCollision:contactOffset = 0.00005
        float physxCollision:restOffset = 0
        color3f[] primvars:displayColor = [(0.12, 0.12, 0.12)]
        double size = 1
        float3 xformOp:scale = (0.012, 0.23, 0.09)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Material "material_0" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 1.2
        float physics:restitution = 0
        float physics:staticFriction = 1.2
    }
}

