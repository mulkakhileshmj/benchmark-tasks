#usda 1.0
(
    defaultPrim = "prop"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "prop" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
)
{
    bool physxArticulation:enabledSelfCollisions = 0
    int physxArticulation:solverPositionIterationCount = 64
    int physxArticulation:solverVelocityIterationCount = 8

    def Xform "root" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxContactReportAPI", "PhysxRigidBodyAPI"]
    )
    {
        float physics:mass = 1
        bool physics:rigidBodyEnabled = 1
        float physxContactReport:threshold = 0
        bool physxRigidBody:enableCCD = 1
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        def Cube "p0" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </prop/Materials/root_0> (
                bindMaterialAs = "weakerThanDescendants"
            )
            bool physics:collisionEnabled = 1
            float physxCollision:contactOffset = 0.00005
            float physxCollision:restOffset = 0
            color3f[] primvars:displayColor = [(0.25, 0.25, 0.25)]
            double size = 1
            quatf xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (0.2, 0.14, 0.015)
            double3 xformOp:translate = (0, 0, -0.015)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }
    }

    def "Materials"
    {
        def Material "root_0" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0
            float physics:staticFriction = 0.5
        }

        def Material "surface_0" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0
            float physics:staticFriction = 0.5
        }
    }

    def Xform "surface" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxContactReportAPI", "PhysxRigidBodyAPI"]
    )
    {
        float physics:mass = 0.5
        bool physics:rigidBodyEnabled = 1
        float physxContactReport:threshold = 0
        bool physxRigidBody:enableCCD = 1
        quatf xformOp:orient = (0.99991435, 0, 0.013089595, 0)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        def Cube "p0" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </prop/Materials/surface_0> (
                bindMaterialAs = "weakerThanDescendants"
            )
            bool physics:collisionEnabled = 1
            float physxCollision:contactOffset = 0.00005
            float physxCollision:restOffset = 0
            color3f[] primvars:displayColor = [(0.55, 0.57, 0.59)]
            double size = 1
            quatf xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (0.2, 0.14, 0.012)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }
    }

    def PhysicsFixedJoint "world_fix"
    {
        rel physics:body1 = </prop/root>
        point3f physics:localPos0 = (0.35, -0.01, 0.8125)
        quatf physics:localRot0 = (1, 0, 0, 0)
    }

    def PhysicsRevoluteJoint "tilt" (
        prepend apiSchemas = ["PhysicsDriveAPI:angular"]
    )
    {
        float drive:angular:physics:damping = 0.4
        float drive:angular:physics:maxForce = 4
        float drive:angular:physics:stiffness = 4
        float drive:angular:physics:targetPosition = 1.5
        uniform token drive:angular:physics:type = "force"
        uniform token physics:axis = "Y"
        rel physics:body0 = </prop/root>
        rel physics:body1 = </prop/surface>
        point3f physics:localPos0 = (0, 0, 0)
        point3f physics:localPos1 = (0, 0, 0)
        float physics:lowerLimit = -4
        float physics:upperLimit = 4
    }
}

